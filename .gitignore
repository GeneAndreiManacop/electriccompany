# Environment and secrets
.env
.env.*
!.env.example

# Dependencies
/vendor/

# CodeIgniter runtime files
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/debugbar/*
/writable/uploads/*

# Keep required directory protection/placeholders
!/writable/.htaccess
!/writable/**/.htaccess
!/writable/index.html
!/writable/**/index.html
!/writable/**/.gitkeep

# Local databases and backups
*.sqlite
*.sqlite3
*.db
*.sql
/backups/

# Tests and coverage output
.phpunit.result.cache
/coverage/

# IDE and operating-system files
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
*.log
